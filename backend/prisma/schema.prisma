generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      String   @default("STARTER")
  isActive  Boolean  @default(true)
  brandName String?
  brandLogo String?
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?  @unique
  subscriptionStatus   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  assistants     VoiceAssistant[]
  phoneNumbers   PhoneNumber[]
  callLogs       CallLog[]
  leadCampaigns  LeadCampaign[]
  leads          Lead[]
  seoCampaigns   SeoCampaign[]
  seoContent     SeoContent[]
  adCampaigns    AdCampaign[]
  adCopies       AdCopy[]
  bookings       Booking[]
  seoEmbedConfig SeoEmbedConfig?
  seoEmbedArticles SeoEmbedArticle[]
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("CLIENT_ADMIN")
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())

  @@index([tenantId])
}

model VoiceAssistant {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  name            String
  vapiAssistantId String?
  systemPrompt    String
  firstMessage    String?
  voiceId         String   @default("Elliot")
  bookingMode     String   @default("manual")
  calendarUrl     String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  phoneNumbers PhoneNumber[]
  callLogs     CallLog[]
  bookings     Booking[]

  @@index([tenantId])
}

model Booking {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  assistantId   String
  assistant     VoiceAssistant @relation(fields: [assistantId], references: [id])
  callerName    String?
  callerPhone   String?
  callerEmail   String?
  service       String?
  dateTime      String?
  status        String   @default("pending")
  notes         String?
  createdAt     DateTime @default(now())

  @@index([tenantId])
  @@index([assistantId])
}

model PhoneNumber {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  number      String   @unique
  twilioSid   String?
  assistantId String?
  assistant   VoiceAssistant? @relation(fields: [assistantId], references: [id])
  createdAt   DateTime @default(now())

  @@index([tenantId])
}

model CallLog {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  assistantId  String?
  assistant    VoiceAssistant? @relation(fields: [assistantId], references: [id])
  vapiCallId   String?   @unique
  callerNumber String?
  direction    String    @default("inbound")
  status       String    @default("pending")
  duration     Int?
  summary      String?
  recordingUrl String?
  startedAt    DateTime?
  endedAt      DateTime?
  createdAt    DateTime  @default(now())

  @@index([tenantId])
  @@index([assistantId])
}

// ==================== AI LEAD GENERATION ====================

model LeadCampaign {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  industry    String?
  jobTitles   String?
  locations   String?
  companySize String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leads Lead[]

  @@index([tenantId])
}

model Lead {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  campaignId   String?
  campaign     LeadCampaign? @relation(fields: [campaignId], references: [id])
  firstName    String?
  lastName     String?
  email        String?
  phone        String?
  company      String?
  jobTitle     String?
  industry     String?
  location     String?
  linkedinUrl  String?
  status       String    @default("new")
  score        Int       @default(0)
  notes        String?
  createdAt    DateTime  @default(now())

  @@index([tenantId])
  @@index([campaignId])
}

// ==================== AI SEO ====================

model SeoCampaign {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  websiteUrl  String?
  targetKeywords String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  content SeoContent[]

  @@index([tenantId])
}

model SeoContent {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  campaignId   String?
  campaign     SeoCampaign? @relation(fields: [campaignId], references: [id])
  title        String
  keyword      String?
  content      String
  metaDescription String?
  status       String   @default("draft")
  wordCount    Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([tenantId])
  @@index([campaignId])
}

// ==================== EMBEDDED SEO (Soro-style auto-publish) ====================

model SeoEmbedConfig {
  id          String   @id @default(cuid())
  tenantId    String   @unique
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  siteUrl     String
  username    String
  appPassword String
  brandVoice  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SeoEmbedArticle {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  title        String
  keyword      String
  content      String
  metaDescription String?
  publishedUrl String?
  wpPostId     Int?
  wordCount    Int      @default(0)
  status       String   @default("published")
  createdAt    DateTime @default(now())

  @@index([tenantId])
}

// ==================== AI AD AUTOMATION ====================

model AdCampaign {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  name          String
  platform      String   @default("google")
  businessType  String?
  targetAudience String?
  budget        Float?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  adCopies AdCopy[]

  @@index([tenantId])
}

model AdCopy {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  campaignId  String?
  campaign    AdCampaign? @relation(fields: [campaignId], references: [id])
  headline    String
  description String
  callToAction String?
  platform    String   @default("google")
  status      String   @default("draft")
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([campaignId])
}
